# Bind-IP. 127.0.0.1 = nur dieser Rechner; 0.0.0.0 = alle IPv4-Interfaces/LAN.
SERVER_IP=127.0.0.1
SERVER_PORT=1312
SERVER_SCHEME=http
# Nur bei SERVER_SCHEME=https benötigt. PEM-Zertifikat/Fullchain und privater Schlüssel.
# Relative Pfade beziehen sich immer auf den Projektordner, nicht das Arbeitsverzeichnis.
SSL_CERT_FILE=
SSL_KEY_FILE=
SSL_KEY_PASSWORD=
# Optional: eigene TTF/OTF, z.B. für erweiterte Unicode-Zeichen.
FONT_PATH=
